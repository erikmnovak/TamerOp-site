{% extends 'markdown/index.md.j2' %}

{% block markdowncell scoped %}
{{ cell.source | documenter_markdown }}
{% endblock markdowncell %}

{% block data_png %}
```@raw html
{% if output.metadata.figure_caption is defined %}<figure class="notebook-figure">{% endif %}{% if output.metadata.figure_min_width is defined %}<div class="notebook-figure-scroll" style="--notebook-figure-min-width: {{ output.metadata.figure_min_width }}px" tabindex="0" role="region" aria-label="Scrollable figure: {{ output.metadata.figure_alt | figure_alt }}">{% endif %}<a href="{{ output.metadata.filenames['image/png'] | path2url | e }}"><img src="{{ output.metadata.filenames['image/png'] | path2url | e }}" alt="{{ output.metadata.figure_alt | figure_alt }}"></a>{% if output.metadata.figure_min_width is defined %}</div>{% endif %}{% if output.metadata.figure_caption is defined %}<figcaption>{{ output.metadata.figure_caption | figure_alt }}</figcaption></figure>{% endif %}
```
{% endblock data_png %}

{% block data_svg %}
```@raw html
{% if output.metadata.figure_caption is defined %}<figure class="notebook-figure">{% endif %}{% if output.metadata.figure_min_width is defined %}<div class="notebook-figure-scroll" style="--notebook-figure-min-width: {{ output.metadata.figure_min_width }}px" tabindex="0" role="region" aria-label="Scrollable figure: {{ output.metadata.figure_alt | figure_alt }}">{% endif %}<a href="{{ output.metadata.filenames['image/svg+xml'] | path2url | e }}"><img src="{{ output.metadata.filenames['image/svg+xml'] | path2url | e }}" alt="{{ output.metadata.figure_alt | figure_alt }}"></a>{% if output.metadata.figure_min_width is defined %}</div>{% endif %}{% if output.metadata.figure_caption is defined %}<figcaption>{{ output.metadata.figure_caption | figure_alt }}</figcaption></figure>{% endif %}
```
{% endblock data_svg %}
